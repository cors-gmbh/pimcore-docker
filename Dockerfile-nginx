ARG NGINX_VERSION=1.21

FROM nginx:${NGINX_VERSION}-alpine AS cors_nginx

# Upstream rebuilds only the current stable/mainline image; older lines stay on an
# outdated Alpine. Pull the release's security fixes on every (weekly) build.
RUN apk upgrade --no-cache

COPY nginx/pimcore-default.conf /etc/nginx/conf.d/default.conf

WORKDIR /var/www/html